<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Procexp.App.App"
    RequestedThemeVariant="Default"
>
    <Application.Styles>
        <FluentTheme />

        <!-- Avalonia's Fluent theme left-aligns button content, which reads as
         ragged text inside the fixed-width buttons dialogs use for OK/Cancel
         rows. Centre it everywhere; selectors do not match derived types, so
         ToggleButton needs naming separately. -->
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>
