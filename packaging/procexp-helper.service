[Unit]
Description=Process Explorer privileged helper
Documentation=https://github.com/microsoft/ProcexpForLinux

[Service]
Type=simple
ExecStart=/usr/lib/procexp/procexp-helper
Restart=on-failure
RestartSec=5

# The socket lives here; systemd creates and cleans it up.
RuntimeDirectory=procexp
RuntimeDirectoryMode=0750

# The helper needs root to read other users' /proc/PID/{io,smaps_rollup,environ}
# and to signal their processes. Everything else is taken away.
#
# CAP_DAC_READ_SEARCH covers the restricted /proc reads; CAP_KILL and
# CAP_SYS_NICE cover the control operations. Dropping the rest means a flaw in
# the daemon cannot load modules, mount filesystems, or change the clock.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_KILL CAP_SYS_NICE CAP_CHOWN
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_KILL CAP_SYS_NICE CAP_CHOWN
NoNewPrivileges=yes

# The helper reads /proc and writes one socket. It has no business anywhere else.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# Not a network service.
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
