<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The /proc parsers work over raw UTF-8 spans and P/Invoke into libc and
         netlink, so unsafe blocks are expected rather than exceptional. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- This is a Linux-only application. Suppress the platform-compatibility
         analyser complaining about Unix-only APIs. -->
    <SupportedOSPlatform>linux</SupportedOSPlatform>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Process Explorer for Linux</Product>
    <Company>Sysinternals</Company>
    <Copyright>Copyright (c) Microsoft Corporation</Copyright>
  </PropertyGroup>

</Project>
