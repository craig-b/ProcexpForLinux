<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Procexp.App.Controls"
    x:Class="Procexp.App.MainWindow"
    Title="Process Explorer"
    Width="1200"
    Height="760"
>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Name="MenuRun" Header="_Run..." InputGesture="Ctrl+R" />
                <MenuItem Name="MenuSave" Header="_Save Process List..." InputGesture="Ctrl+S" />
                <Separator />
                <MenuItem Name="MenuExit" Header="E_xit" />
            </MenuItem>

            <MenuItem Header="_Options">
                <MenuItem Name="MenuAlwaysOnTop" Header="Always On _Top" ToggleType="CheckBox" />
                <MenuItem
                    Name="MenuHighlight"
                    Header="_Highlight New and Deleted"
                    ToggleType="CheckBox"
                    IsChecked="True"
                />
                <Separator />
                <MenuItem Name="MenuColumns" Header="Select _Columns..." />
                <MenuItem Name="MenuSettings" Header="_Options..." />
                <Separator />
                <MenuItem Name="MenuInstallHelper" Header="_Privileged Helper Status..." />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem
                    Name="MenuPause"
                    Header="_Pause"
                    InputGesture="Space"
                    ToggleType="CheckBox"
                />
                <MenuItem Name="MenuRefreshNow" Header="_Update Now" InputGesture="F5" />
                <Separator />
                <MenuItem
                    Name="MenuSystemInfo"
                    Header="S_ystem Information..."
                    InputGesture="Ctrl+I"
                />
                <Separator />
                <MenuItem Name="MenuColumnSets" Header="Column _Sets">
                    <MenuItem Name="MenuSaveColumnSet" Header="Save Current Set..." />
                    <MenuItem Name="MenuOrganizeColumnSets" Header="Organize Sets..." />
                    <Separator Name="MenuColumnSetsSeparator" />
                </MenuItem>
                <Separator />
                <MenuItem
                    Name="MenuTreeMode"
                    Header="Show Process _Tree"
                    ToggleType="CheckBox"
                    IsChecked="True"
                    InputGesture="Ctrl+T"
                />
                <Separator />
                <MenuItem
                    Name="MenuLowerPane"
                    Header="Show _Lower Pane"
                    ToggleType="CheckBox"
                    IsChecked="True"
                    InputGesture="Ctrl+L"
                />
                <MenuItem Header="Lower Pane _View">
                    <MenuItem
                        Name="MenuPaneModules"
                        Header="_Mapped Files"
                        ToggleType="Radio"
                        GroupName="Pane"
                        IsChecked="True"
                    />
                    <MenuItem
                        Name="MenuPaneHandles"
                        Header="_Handles"
                        ToggleType="Radio"
                        GroupName="Pane"
                    />
                    <MenuItem
                        Name="MenuPaneThreads"
                        Header="_Threads"
                        ToggleType="Radio"
                        GroupName="Pane"
                    />
                </MenuItem>
                <Separator />
                <MenuItem Header="Update _Speed">
                    <MenuItem
                        Name="MenuSpeedFast"
                        Header="_Fast (0.5 s)"
                        ToggleType="Radio"
                        GroupName="Speed"
                    />
                    <MenuItem
                        Name="MenuSpeedNormal"
                        Header="_Normal (1 s)"
                        ToggleType="Radio"
                        GroupName="Speed"
                        IsChecked="True"
                    />
                    <MenuItem
                        Name="MenuSpeedSlow"
                        Header="_Slow (2 s)"
                        ToggleType="Radio"
                        GroupName="Speed"
                    />
                    <MenuItem
                        Name="MenuSpeedVerySlow"
                        Header="_Very Slow (5 s)"
                        ToggleType="Radio"
                        GroupName="Speed"
                    />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Process">
                <MenuItem Name="MenuProperties" Header="P_roperties..." InputGesture="Enter" />
                <Separator />
                <MenuItem Name="MenuKill" Header="_Kill Process" InputGesture="Delete" />
                <MenuItem
                    Name="MenuKillTree"
                    Header="Kill Process _Tree"
                    InputGesture="Shift+Delete"
                />
                <Separator />
                <MenuItem Name="MenuSuspend" Header="_Suspend" />
                <MenuItem Name="MenuResume" Header="_Resume" />
                <MenuItem Name="MenuRestart" Header="Res_tart" />
                <Separator />
                <MenuItem Header="Set _Priority">
                    <MenuItem Name="MenuNiceHighest" Header="Highest (nice -20)" />
                    <MenuItem Name="MenuNiceHigh" Header="Above Normal (nice -5)" />
                    <MenuItem Name="MenuNiceNormal" Header="Normal (nice 0)" />
                    <MenuItem Name="MenuNiceLow" Header="Below Normal (nice 5)" />
                    <MenuItem Name="MenuNiceLowest" Header="Lowest (nice 19)" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Find">
                <MenuItem
                    Name="MenuFind"
                    Header="Find _Handle or Mapped File..."
                    InputGesture="Ctrl+F"
                />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Name="MenuAbout" Header="_About Process Explorer" />
            </MenuItem>
        </Menu>

        <Border
            DockPanel.Dock="Bottom"
            Padding="8,4"
            BorderThickness="0,1,0,0"
            BorderBrush="#40808080"
        >
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="StatusText" FontSize="11" VerticalAlignment="Center" />
                <TextBlock
                    Name="TimingText"
                    Grid.Column="1"
                    FontSize="11"
                    FontFamily="monospace"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                />
            </Grid>
        </Border>

        <Border
            DockPanel.Dock="Top"
            Padding="8,6"
            BorderThickness="0,0,0,1"
            BorderBrush="#40808080"
        >
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Buttons size to their content: an icon plus a label. The
                 Pause icon and label are swapped from code when the sweep is
                 paused, so both carry names. -->
                <Button Name="PauseButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon
                            Name="PauseIcon"
                            Data="M14,19H18V5H14M6,19H10V5H6V19Z"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                        />
                        <TextBlock Name="PauseLabel" Text="Pause" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Name="RefreshButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon
                            Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                        />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Margin="4,2" Fill="#40808080" />
                <Button Name="KillButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon
                            Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Foreground="#E0645C"
                        />
                        <TextBlock Text="Kill" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Name="SuspendButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon
                            Data="M15,16H13V8H15M11,16H9V8H11M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                        />
                        <TextBlock Text="Suspend" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Margin="4,2" Fill="#40808080" />
                <ToggleSwitch
                    Name="TreeToggle"
                    IsChecked="True"
                    OnContent="Tree"
                    OffContent="Flat"
                    MinWidth="90"
                />
                <Rectangle Width="1" Margin="4,2" Fill="#40808080" />
                <ComboBox Name="PaneModeCombo" SelectedIndex="0" MinWidth="130" />
                <ToggleButton
                    Name="LowerPaneToggle"
                    Content="Lower Pane"
                    IsChecked="True"
                    MinWidth="100"
                />
                <Rectangle Width="1" Margin="4,2" Fill="#40808080" />
                <TextBox
                    Name="FilterBox"
                    PlaceholderText="Filter (Ctrl+Shift+F)"
                    MinWidth="170"
                    VerticalAlignment="Center"
                />
                <!-- Live sparklines, as in Process Explorer's toolbar. Clicking
                 one opens System Information at the matching tab. -->
                <StackPanel
                    Name="Sparklines"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                />
            </StackPanel>
        </Border>

        <!-- Upper and lower panes, split by a draggable divider. The lower pane's
         height is the user's to choose, so the row is sized in stars and simply
         collapsed to zero when the pane is hidden. -->
        <Grid Name="PaneSplit" RowDefinitions="3*,Auto,2*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
                <controls:ProcessTreeView Name="Tree" Grid.Row="0" Grid.Column="0">
                    <controls:ProcessTreeView.ContextMenu>
                        <ContextMenu Name="RowMenu">
                            <MenuItem Name="CtxProperties" Header="Properties..." />
                            <Separator />
                            <MenuItem Name="CtxKill" Header="Kill Process" />
                            <MenuItem Name="CtxKillTree" Header="Kill Process Tree" />
                            <Separator />
                            <MenuItem Name="CtxSuspend" Header="Suspend" />
                            <MenuItem Name="CtxResume" Header="Resume" />
                            <MenuItem Name="CtxRestart" Header="Restart" />
                            <Separator />
                            <MenuItem Name="CtxCopyPath" Header="Copy Path" />
                            <MenuItem Name="CtxCopyCommandLine" Header="Copy Command Line" />
                        </ContextMenu>
                    </controls:ProcessTreeView.ContextMenu>
                </controls:ProcessTreeView>

                <ScrollBar
                    Name="VerticalScroll"
                    Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Vertical"
                    Visibility="Visible"
                />

                <!-- Horizontal scrolling applies only to the metric columns, so the bar
           starts where the frozen name pane ends rather than spanning the width.
           A bar under the frozen pane would imply it scrolls too. -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*">
                    <Border Name="ScrollGutter" Grid.Column="0" />
                    <ScrollBar
                        Name="HorizontalScroll"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Visibility="Visible"
                    />
                </Grid>
            </Grid>

            <GridSplitter
                Name="PaneSplitter"
                Grid.Row="1"
                Height="5"
                ResizeDirection="Rows"
                Background="#20808080"
            />

            <ContentControl Name="LowerPaneHost" Grid.Row="2" />
        </Grid>
    </DockPanel>
</Window>
